# Postgres (docker-compose)
POSTGRES_DB=banex_reintegra
POSTGRES_USER=banex
POSTGRES_PASSWORD=banex_local_password

# Conexión usada por Prisma desde el backend
DATABASE_URL=postgresql://banex:banex_local_password@localhost:5432/banex_reintegra?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Llaves externas (solo en .env real, NUNCA commitear)
ANTHROPIC_API_KEY=
