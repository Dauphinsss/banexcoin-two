# Conexión usada por Prisma desde el backend.
# Relative to backend/prisma when commands run from backend.
DATABASE_URL=file:./dev.db

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Llaves externas (solo en .env real, NUNCA commitear)
ANTHROPIC_API_KEY=


PLAYWRIGHT_BASE_URL="http://127.0.0.1:4321"