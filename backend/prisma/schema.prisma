// BanexReintegra - Prisma schema
//
// Reglas (ver CONVENTIONS.md seccion 1):
// - Todos los montos monetarios usan Decimal
// - Porcentajes: Decimal
// - Identificadores externos (Excel) viajan como String
// - Audit trail obligatorio: createdAt, updatedAt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================================
// USUARIOS
// =========================================================================

model UserAccount {
  id                 String              @id @default(cuid())
  externalId         String?
  username           String?
  accountNumber      String              @unique
  displayName        String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  transactions       LedgerTransaction[]
  senderTransfers    TransferDetail[]    @relation("TransferSender")
  receiverTransfers  TransferDetail[]    @relation("TransferReceiver")
  rebates            MonthlyRebate[]

  @@index([username])
  @@index([externalId])
}

// =========================================================================
// UPLOADS (carga de archivos)
// =========================================================================

model Upload {
  id                  String                 @id @default(cuid())
  originalName        String
  storagePath         String
  mimeType            String
  fileSizeBytes       Int
  fileHash            String                 @unique
  period              String?                // "2025-05"; nullable hasta que el parser lo infiera
  status              String                 @default("PENDING") // UploadStatus en packages/types
  rowCount            Int                    @default(0)
  transactionRowCount Int                    @default(0)
  extractRowCount     Int                    @default(0)
  parseErrorCount     Int                    @default(0)
  anomalyCount        Int                    @default(0)
  errorMessage        String?
  supersedesUploadId  String?
  processedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  supersedesUpload    Upload?                @relation("UploadSupersession", fields: [supersedesUploadId], references: [id])
  supersededByUploads Upload[]               @relation("UploadSupersession")

  transactions        LedgerTransaction[]
  extractEntries      BankExtractEntry[]
  rebates             MonthlyRebate[]
  anomalies           ReconciliationAnomaly[]
  parseErrors         ParseError[]
  reports             GeneratedReport[]

  @@index([period])
  @@index([status])
  @@index([supersedesUploadId])
}

// =========================================================================
// MOVIMIENTOS CANONICOS
// =========================================================================

model LedgerTransaction {
  id                    String                  @id @default(cuid())
  uploadId              String
  upload                Upload                  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  userAccountId         String?
  userAccount           UserAccount?            @relation(fields: [userAccountId], references: [id])
  serviceCode           String
  serviceName           String?
  sourceSheet           String
  sourceRowNumber       Int?
  transactionId         String                  // Clave de conciliacion y trazabilidad operativa
  referenceNumber       String?
  status                String?
  direction             String?                 // DEBIT | CREDIT
  productSymbol         String?
  blockchain            String?
  amountBOB             Decimal?
  amountUSDT            Decimal?
  feeBOB                Decimal?                @default(0)
  feeUSDT               Decimal?                @default(0)
  netAmountBOB          Decimal?
  netAmountUSDT         Decimal?
  exchangeRate          Decimal?
  transactedAt          DateTime?
  reconciledWithExtract Boolean                 @default(false)
  rawRow                String
  createdAt             DateTime                @default(now())

  qrDetail              QrTransactionDetail?
  transferDetail        TransferDetail?
  rebateItems           MonthlyRebateItem[]
  anomalies             ReconciliationAnomaly[]

  @@unique([uploadId, serviceCode, transactionId])
  @@index([transactionId])
  @@index([userAccountId])
  @@index([serviceCode])
  @@index([sourceSheet])
}

// =========================================================================
// DETALLE QR
// =========================================================================

model QrTransactionDetail {
  id                  String             @id @default(cuid())
  ledgerTransactionId String             @unique
  ledgerTransaction   LedgerTransaction  @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)
  quoteNumber         String?
  sideClient          String?
  currencyCode        String?
  paidAmountBOB       Decimal?
  exchangedAmountUSDT Decimal?
  createdAtSource     DateTime?
  updatedAtSource     DateTime?
  createdAt           DateTime           @default(now())
}

// =========================================================================
// DETALLE DE TRANSFERENCIAS
// =========================================================================

model TransferDetail {
  id                   String             @id @default(cuid())
  ledgerTransactionId  String             @unique
  ledgerTransaction    LedgerTransaction  @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)
  transferNumber       String?
  senderUserAccountId  String?
  senderUserAccount    UserAccount?       @relation("TransferSender", fields: [senderUserAccountId], references: [id])
  receiverUserAccountId String?
  receiverUserAccount  UserAccount?       @relation("TransferReceiver", fields: [receiverUserAccountId], references: [id])
  senderAlias          String?
  receiverAlias        String?
  createdAt            DateTime           @default(now())

  @@index([senderUserAccountId])
  @@index([receiverUserAccountId])
}

// =========================================================================
// EXTRACTOS BANCARIOS / EVIDENCIA DE CONCILIACION
// =========================================================================

model BankExtractEntry {
  id              String                  @id @default(cuid())
  uploadId        String
  upload          Upload                  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  extractKind     String
  sourceSheet     String
  sourceRowNumber Int?
  transactionId   String
  transactedAt    DateTime?
  amountBOB       Decimal
  rawRow          String
  createdAt       DateTime                @default(now())

  anomalies       ReconciliationAnomaly[]

  @@index([uploadId])
  @@index([transactionId])
  @@index([sourceSheet])
}

// =========================================================================
// NIVELES DE CASHBACK (versionados)
// =========================================================================

model CashbackTier {
  id              String         @id @default(cuid())
  level           Int
  name            String
  minAmountBOB    Decimal
  maxAmountBOB    Decimal?       // null = sin tope superior
  rebatePercent   Decimal
  validFromPeriod String
  validToPeriod   String?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  rebates         MonthlyRebate[]

  @@index([active])
  @@index([validFromPeriod, validToPeriod])
}

// =========================================================================
// REINTEGROS MENSUALES
// =========================================================================

model MonthlyRebate {
  id              String              @id @default(cuid())
  uploadId        String
  upload          Upload              @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  userAccountId   String
  userAccount     UserAccount         @relation(fields: [userAccountId], references: [id])
  tierId          String?
  tier            CashbackTier?       @relation(fields: [tierId], references: [id])
  period          String              // "2025-05"

  totalSpentBOB   Decimal
  totalSpentUSDT  Decimal
  avgExchangeRate Decimal
  rebatePercent   Decimal
  rebateBOB       Decimal
  rebateUSDT      Decimal
  payoutStatus    String              @default("PENDING")
  exported        Boolean             @default(false)
  paidOut         Boolean             @default(false)
  paidOutAt       DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items           MonthlyRebateItem[]

  @@unique([uploadId, userAccountId])
  @@index([uploadId])
  @@index([period])
  @@index([tierId])
}

// =========================================================================
// ANOMALIAS DE CONCILIACION
// =========================================================================

model ReconciliationAnomaly {
  id                 String             @id @default(cuid())
  uploadId           String
  upload             Upload             @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  ledgerTransactionId String?
  ledgerTransaction  LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)
  bankExtractEntryId String?
  bankExtractEntry   BankExtractEntry?  @relation(fields: [bankExtractEntryId], references: [id], onDelete: Cascade)
  transactionId      String
  serviceCode        String?
  type               String             // AnomalyType en packages/types
  ledgerAmountBOB    Decimal?
  extractAmountBOB   Decimal?
  deltaBOB           Decimal?

  resolved           Boolean            @default(false)
  resolutionNote     String?
  resolvedAt         DateTime?

  createdAt          DateTime           @default(now())

  @@index([uploadId, type])
  @@index([transactionId])
  @@index([serviceCode])
  @@index([type, resolved])
  @@index([ledgerTransactionId])
  @@index([bankExtractEntryId])
}

// =========================================================================
// ERRORES DE PARSEO (auditoria de filas invalidas)
// =========================================================================

model ParseError {
  id          String   @id @default(cuid())
  uploadId    String
  upload      Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  sheetName   String
  rowNumber   Int
  columnName  String?
  errorCode   String?
  message     String
  rawRow      String?
  createdAt   DateTime @default(now())

  @@index([uploadId])
}

// =========================================================================
// DETALLE DE REINTEGROS
// =========================================================================

model MonthlyRebateItem {
  id                  String             @id @default(cuid())
  monthlyRebateId     String
  monthlyRebate       MonthlyRebate      @relation(fields: [monthlyRebateId], references: [id], onDelete: Cascade)
  ledgerTransactionId String
  ledgerTransaction   LedgerTransaction  @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)
  amountBOB           Decimal
  amountUSDT          Decimal
  exchangeRate        Decimal
  createdAt           DateTime           @default(now())

  @@index([monthlyRebateId])
  @@index([ledgerTransactionId])
}

// =========================================================================
// REPORTES GENERADOS
// =========================================================================

model GeneratedReport {
  id          String   @id @default(cuid())
  uploadId    String
  upload      Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  type        String
  format      String
  storagePath String
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([uploadId])
  @@index([type, format])
}
