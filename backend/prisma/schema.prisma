// BanexReintegra — Prisma schema
//
// Reglas (ver CONVENTIONS.md sección 1):
// - Todos los montos monetarios usan Decimal
// - Porcentajes: Decimal
// - Identificadores externos (Excel) viajan como String
// - Audit trail obligatorio: createdAt, updatedAt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =========================================================================
// USUARIOS
// =========================================================================

model UserAccount {
  id            String          @id @default(cuid())
  externalId    String?
  username      String?
  accountNumber String          @unique
  displayName   String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  transactions  QRTransaction[]
  rebates       MonthlyRebate[]

  @@index([username])
  @@index([externalId])
}

// =========================================================================
// UPLOADS (carga de archivos)
// =========================================================================

model Upload {
  id                  String                 @id @default(cuid())
  originalName        String
  storagePath         String
  mimeType            String
  fileSizeBytes       Int
  fileHash            String                 @unique
  period              String?                // "2025-05"; nullable hasta que el parser lo infiera
  status              String                 @default("PENDING") // UploadStatus en packages/types
  rowCount            Int                    @default(0)
  qrRowCount          Int                    @default(0)
  extractRowCount     Int                    @default(0)
  parseErrorCount     Int                    @default(0)
  anomalyCount        Int                    @default(0)
  errorMessage        String?
  supersedesUploadId  String?
  processedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  supersedesUpload    Upload?                @relation("UploadSupersession", fields: [supersedesUploadId], references: [id])
  supersededByUploads Upload[]               @relation("UploadSupersession")

  qrTransactions      QRTransaction[]
  extractTransactions ExtractTransaction[]
  rebates             MonthlyRebate[]
  anomalies           ReconciliationAnomaly[]
  parseErrors         ParseError[]
  reports             GeneratedReport[]

  @@index([period])
  @@index([status])
  @@index([supersedesUploadId])
}

// =========================================================================
// TRANSACCIONES QR
// =========================================================================

model QRTransaction {
  id                    String                  @id @default(cuid())
  uploadId              String
  upload                Upload                  @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  userAccountId         String
  userAccount           UserAccount             @relation(fields: [userAccountId], references: [id])
  transactionId         String                  // "Transacción Id" — clave de conciliación
  transactedAt          DateTime?
  amountBOB             Decimal
  amountUSDT            Decimal
  exchangeRate          Decimal
  feeBOB                Decimal?                @default(0)
  feeUSDT               Decimal?                @default(0)
  reconciledWithExtract Boolean                 @default(false)
  rawRow                String
  createdAt             DateTime                @default(now())

  anomaly               ReconciliationAnomaly?
  rebateItems           MonthlyRebateItem[]

  // Un transactionId puede repetirse entre uploads (mismo mes recargado),
  // pero no dentro del mismo upload.
  @@unique([uploadId, transactionId])
  @@index([transactionId])
  @@index([userAccountId])
}

// =========================================================================
// TRANSACCIONES DE EXTRACTO
// =========================================================================

model ExtractTransaction {
  id                   String                 @id @default(cuid())
  uploadId             String
  upload               Upload                 @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  transactionId        String
  transactedAt         DateTime?
  amountBOB            Decimal
  reference            String?
  rawRow               String
  createdAt            DateTime               @default(now())

  anomaly              ReconciliationAnomaly?

  @@index([uploadId])
  @@index([transactionId])
}

// =========================================================================
// NIVELES DE CASHBACK (versionados)
// =========================================================================

model CashbackTier {
  id              String         @id @default(cuid())
  level           Int
  name            String
  minAmountBOB    Decimal
  maxAmountBOB    Decimal?       // null = sin tope superior
  rebatePercent   Decimal
  validFromPeriod String
  validToPeriod   String?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  rebates         MonthlyRebate[]

  @@index([active])
  @@index([validFromPeriod, validToPeriod])
}

// =========================================================================
// REINTEGROS MENSUALES
// =========================================================================

model MonthlyRebate {
  id              String              @id @default(cuid())
  uploadId        String
  upload          Upload              @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  userAccountId   String
  userAccount     UserAccount         @relation(fields: [userAccountId], references: [id])
  tierId          String?
  tier            CashbackTier?       @relation(fields: [tierId], references: [id])
  period          String              // "2025-05"

  totalSpentBOB   Decimal
  totalSpentUSDT  Decimal
  avgExchangeRate Decimal
  rebatePercent   Decimal
  rebateBOB       Decimal
  rebateUSDT      Decimal
  payoutStatus    String              @default("PENDING")
  exported        Boolean             @default(false)
  paidOut         Boolean             @default(false)
  paidOutAt       DateTime?

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items           MonthlyRebateItem[]

  @@unique([uploadId, userAccountId])
  @@index([uploadId])
  @@index([period])
  @@index([tierId])
}

// =========================================================================
// ANOMALÍAS DE CONCILIACIÓN
// =========================================================================

model ReconciliationAnomaly {
  id                   String                @id @default(cuid())
  uploadId             String
  upload               Upload                @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  qrTransactionId      String?               @unique
  qrTransaction        QRTransaction?        @relation(fields: [qrTransactionId], references: [id])
  extractTransactionId String?               @unique
  extractTransaction   ExtractTransaction?   @relation(fields: [extractTransactionId], references: [id])
  transactionId        String
  type                 String                // AnomalyType en packages/types
  qrAmountBOB          Decimal?
  extractAmountBOB     Decimal?
  deltaBOB             Decimal?

  resolved             Boolean               @default(false)
  resolutionNote       String?
  resolvedAt           DateTime?

  createdAt            DateTime              @default(now())

  @@index([uploadId, type])
  @@index([transactionId])
  @@index([type, resolved])
}

// =========================================================================
// ERRORES DE PARSEO (auditoría de filas inválidas)
// =========================================================================

model ParseError {
  id          String   @id @default(cuid())
  uploadId    String
  upload      Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  sheetName   String
  rowNumber   Int
  columnName  String?
  errorCode   String?
  message     String
  rawRow      String?
  createdAt   DateTime @default(now())

  @@index([uploadId])
}

// =========================================================================
// DETALLE DE REINTEGROS
// =========================================================================

model MonthlyRebateItem {
  id              String         @id @default(cuid())
  monthlyRebateId String
  monthlyRebate   MonthlyRebate  @relation(fields: [monthlyRebateId], references: [id], onDelete: Cascade)
  qrTransactionId String
  qrTransaction   QRTransaction  @relation(fields: [qrTransactionId], references: [id])
  amountBOB       Decimal
  amountUSDT      Decimal
  exchangeRate    Decimal
  createdAt       DateTime       @default(now())

  @@index([monthlyRebateId])
  @@index([qrTransactionId])
}

// =========================================================================
// REPORTES GENERADOS
// =========================================================================

model GeneratedReport {
  id          String   @id @default(cuid())
  uploadId    String
  upload      Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  type        String
  format      String
  storagePath String
  generatedBy String?
  createdAt   DateTime @default(now())

  @@index([uploadId])
  @@index([type, format])
}
