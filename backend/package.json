{
  "name": "banex-reintegra-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "bun run --cwd .. build:shared",
    "dev": "nest start --watch",
    "start": "nest start",
    "prestart:dev": "bun run --cwd .. build:shared",
    "start:dev": "nest start --watch",
    "prebuild": "bun run --cwd .. build:shared",
    "build": "nest build",
    "start:prod": "node --env-file=.env.production dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@banex/types": "workspace:*",
    "@banex/utils": "workspace:*",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "dotenv": "latest",
    "exceljs": "^4.4.0",
    "multer": "^1.4.5-lts.1",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "latest",
    "@eslint/js": "latest",
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "prettier": "latest",
    "prisma": "^5.22.0",
    "source-map-support": "latest",
    "ts-loader": "latest",
    "ts-node": "latest",
    "tsconfig-paths": "latest",
    "tsx": "^4.19.0",
    "typescript": "latest",
    "vitest": "^2.1.0"
  }
}
