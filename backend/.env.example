NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:4321

# Base de datos local SQLite (se crea en backend/prisma/dev.db)
DATABASE_URL=file:./dev.db

# Redis para BullMQ
REDIS_URL=redis://localhost:6379

# Límites operativos
MAX_UPLOAD_SIZE_MB=50
RECONCILE_TOLERANCE_BOB=0.01

# Almacenamiento de archivos subidos (relativo al cwd del backend)
UPLOAD_STORAGE_DIR=./data/uploads

# Cuenta de tesorería para BanexTransfer (sender de los reintegros)
TREASURY_ACCOUNT_NUMBER=10000
TREASURY_ACCOUNT_ALIAS=BanexTesoreria

# Claude (opcional, F9)
ANTHROPIC_API_KEY=
