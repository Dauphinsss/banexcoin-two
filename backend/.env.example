NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:4321

# PostgreSQL usado por Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# Límites operativos
MAX_UPLOAD_SIZE_MB=50
RECONCILE_TOLERANCE_BOB=0.01
UPLOAD_DUPLICATE_MODE=test
UPLOAD_OVERWRITE_USER_NAMES=false

# Rate limiting HTTP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Almacenamiento de archivos subidos (relativo al cwd del backend)
UPLOAD_STORAGE_DIR=./data/uploads

# Cuenta de tesorería para BanexTransfer (sender de los reintegros)
TREASURY_ACCOUNT_NUMBER=10000
TREASURY_ACCOUNT_ALIAS=BanexTesoreria

# Opcional: habilita explicación de anomalías con Gemini.
GEMINI_API_KEY=
