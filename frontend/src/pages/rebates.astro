---
import AppShell from '../layouts/AppShell.astro'
import { RebatesTable } from '../islands/rebates/RebatesTable'
---

<AppShell title="Reintegros" activePage="rebates">
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-semibold tracking-tight text-slate-100">Tabla de reintegros</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-400">
        Usuarios calculados desde el último upload procesado, con nivel asignado,
        monto a pagar y tipo de cambio promedio.
      </p>
    </div>

    <RebatesTable client:load />
  </div>
</AppShell>
