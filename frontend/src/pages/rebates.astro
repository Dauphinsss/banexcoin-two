---
import AppShell from '../layouts/AppShell.astro'
import { RebatesTable } from '../islands/rebates/RebatesTable'
import { DownloadsPanel } from '../islands/reports/DownloadsPanel'
---

<AppShell title="Reintegros" activePage="rebates">
  <div class="space-y-6">
    <section class="space-y-2">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
        Usuarios y pagos
      </div>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Tabla de reintegros</h2>
      <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
        Usuarios calculados desde el último upload procesado, con nivel asignado,
        monto a pagar y tipo de cambio promedio. Haz click en una fila para ver
        el detalle del usuario.
      </p>
    </section>

    <DownloadsPanel client:visible />

    <RebatesTable client:load />
  </div>
</AppShell>
