---
import AppShell from '../layouts/AppShell.astro'
import PageHeader from '../components/PageHeader.astro'
import { RebatesTable } from '../islands/rebates/RebatesTable'
import { DownloadsPanel } from '../islands/reports/DownloadsPanel'
---

<AppShell title="Reintegros" activePage="rebates">
  <div class="min-w-0 space-y-6">
    <PageHeader
      eyebrow="Usuarios y pagos"
      title="Tabla de reintegros"
      accent="reintegros"
      description="Usuarios calculados desde el último archivo procesado, con nivel asignado, monto a pagar y tipo de cambio promedio. Haz click en una fila para ver el detalle del usuario."
    />

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Exportaciones
        </h3>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <DownloadsPanel client:visible />
    </section>

    <div class="pt-2">
      <div class="h-px w-full bg-linear-to-r from-transparent via-border to-transparent"></div>
    </div>

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Detalle de usuarios
        </h3>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <RebatesTable client:load />
    </section>
  </div>
</AppShell>
