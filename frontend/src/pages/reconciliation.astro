---
import AppShell from '../layouts/AppShell.astro'
import PageHeader from '../components/PageHeader.astro'
import { AnomalyPanel } from '../islands/reconciliation/AnomalyPanel'
---

<AppShell title="Conciliación" activePage="reconciliation">
  <div class="space-y-6">
    <PageHeader
      eyebrow="Control bancario"
      title="Anomalías de conciliación"
      accent="conciliación"
      description="Cruce de Pago QR contra Extracto de Pagos por identificador de transacción y monto. Resuelve las anomalías manualmente o pide a la IA un análisis de patrones."
    />

    <AnomalyPanel client:load />
  </div>
</AppShell>
