---
import AppShell from '../layouts/AppShell.astro'
import { LatestResults } from '../islands/dashboard/LatestResults'
---

<AppShell title="Dashboard" activePage="dashboard">
  <div class="space-y-6">
    <div class="rounded-lg border border-slate-800 bg-slate-900/40 p-6">
      <h2 class="text-xl font-semibold tracking-tight text-slate-100">
        Resultados del cashback mensual
      </h2>
      <p class="mt-2 text-sm text-slate-400 max-w-2xl">
        Vista ejecutiva del último Excel procesado: reintegros, usuarios,
        conciliación y anomalías.
      </p>
    </div>

    <LatestResults client:load />
  </div>
</AppShell>
