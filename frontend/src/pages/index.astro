---
import AppShell from '../layouts/AppShell.astro'
import { LatestResults } from '../islands/dashboard/LatestResults'
import { DownloadsPanel } from '../islands/reports/DownloadsPanel'
---

<AppShell title="Dashboard" activePage="dashboard">
  <div class="space-y-6">
    {/* Hero */}
    <section class="relative overflow-hidden rounded-xl border border-border bg-card/70 shadow-xl shadow-black/10">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-32 left-1/3 h-72 w-72 rounded-full bg-violet-500/10 blur-3xl"
      />

      <div class="relative grid gap-6 p-6 md:grid-cols-[1fr_auto] md:items-end md:p-10">
        <div class="max-w-2xl space-y-4">
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
            <span class="relative flex size-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-60"></span>
              <span class="relative inline-flex size-1.5 rounded-full bg-primary"></span>
            </span>
            Operación mensual
          </div>
          <h2 class="text-3xl font-semibold tracking-tight md:text-4xl">
            Resultados del <span class="text-primary">cashback</span> mensual
          </h2>
          <p class="max-w-xl text-sm leading-6 text-muted-foreground md:text-[15px]">
            Vista ejecutiva del último Excel procesado: reintegros calculados,
            usuarios beneficiados, conciliación bancaria y anomalías accionables.
          </p>

          <div class="flex flex-wrap gap-3 pt-2">
            <a
              href="/uploads/new"
              class="inline-flex items-center gap-2 rounded-md bg-primary px-4 h-10 text-sm font-medium text-primary-foreground shadow transition-all hover:bg-primary/90 hover:shadow-md hover:shadow-primary/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" x2="12" y1="3" y2="15" />
              </svg>
              Subir reporte
            </a>
            <a
              href="/reconciliation"
              class="inline-flex items-center gap-2 rounded-md border border-border bg-background/40 px-4 h-10 text-sm font-medium text-foreground transition-colors hover:bg-accent hover:text-accent-foreground"
            >
              Revisar control bancario
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
              </svg>
            </a>
          </div>
        </div>

        {/* Decorative mark */}
        <div class="hidden md:block">
          <div class="relative grid size-32 place-items-center rounded-2xl border border-primary/30 bg-gradient-to-br from-primary/20 via-primary/5 to-transparent">
            <div class="absolute inset-1 rounded-xl border border-primary/10"></div>
            <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary">
              <circle cx="8" cy="8" r="6"/>
              <path d="M18.09 10.37A6 6 0 1 1 10.34 18"/>
              <path d="M7 6h1v4"/>
              <path d="m16.71 13.88.7.71-2.82 2.82"/>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Resumen del cierre
        </h3>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <LatestResults client:load />
    </section>

    <div class="pt-2">
      <div class="h-px w-full bg-linear-to-r from-transparent via-border to-transparent"></div>
    </div>

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Exportaciones
        </h3>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <DownloadsPanel client:visible />
    </section>
  </div>
</AppShell>
