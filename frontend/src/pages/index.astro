---
import AppShell from '../layouts/AppShell.astro'
import { LatestResults } from '../islands/dashboard/LatestResults'
import { DownloadsPanel } from '../islands/reports/DownloadsPanel'
---

<AppShell title="Dashboard" activePage="dashboard">
  <div class="space-y-6">
    <div class="rounded-lg border border-line bg-panel p-6">
      <h2 class="text-xl font-semibold tracking-tight text-main">
        Resultados del cashback mensual
      </h2>
      <p class="mt-2 text-sm text-muted max-w-2xl">
        Vista ejecutiva del último Excel procesado: reintegros, usuarios,
        conciliación y anomalías.
      </p>
    </div>

    <LatestResults client:load />

    <DownloadsPanel client:visible />
  </div>
</AppShell>
