---
import AppShell from '../layouts/AppShell.astro'
import { LatestResults } from '../islands/dashboard/LatestResults'
import { DownloadsPanel } from '../islands/reports/DownloadsPanel'
---

<AppShell title="Dashboard" activePage="dashboard">
  <div class="reveal-stack min-w-0 space-y-6">
    <section class="rounded-xl border border-border bg-card/70 px-4 py-3 shadow-lg shadow-black/10 md:px-5">
      <div class="flex min-h-20 flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2">
          <div class="min-w-0">
            <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
              Cierre activo
            </p>
            <h2 class="truncate text-base font-semibold tracking-tight md:text-lg">
              Cashback mensual
            </h2>
          </div>
          <div class="h-8 w-px bg-border max-md:hidden"></div>
          <div class="flex flex-wrap items-center gap-2 text-sm">
            <span class="inline-flex items-center gap-2 rounded-full border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-medium text-amber-300">
              <span class="size-1.5 rounded-full bg-amber-400"></span>
              En curso
            </span>
            <span class="text-muted-foreground">Pendiente conciliar anomalías abiertas</span>
          </div>
        </div>

        <a
          href="/reconciliation"
          class="banex-primary-button inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-full px-4 text-sm font-semibold text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Revisar conciliación
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
          </svg>
        </a>
      </div>
    </section>

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Resumen del cierre
        </h3>
        <span class="section-rule h-px flex-1 bg-border"></span>
      </div>
      <LatestResults client:load />
    </section>

    <div class="pt-2">
      <div class="h-px w-full bg-linear-to-r from-transparent via-border to-transparent"></div>
    </div>

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Exportaciones
        </h3>
        <span class="section-rule h-px flex-1 bg-border"></span>
      </div>
      <DownloadsPanel client:visible />
    </section>
  </div>
</AppShell>
