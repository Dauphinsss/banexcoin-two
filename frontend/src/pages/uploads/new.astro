---
import AppShell from '../../layouts/AppShell.astro'
import UploadDropzone from '../../islands/upload/UploadDropzone.tsx'
---

<AppShell title="Subir Excel" activePage="uploads">
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-semibold tracking-tight text-main">
        Cargar reporte mensual de pagos QR
      </h2>
      <p class="mt-1 text-sm text-muted max-w-2xl">
        El archivo se valida, se calcula su hash SHA-256 y se encola para
        procesamiento. Si ya fue subido antes, te llevamos a los resultados existentes.
      </p>
    </div>

    <UploadDropzone client:load />
  </div>
</AppShell>
