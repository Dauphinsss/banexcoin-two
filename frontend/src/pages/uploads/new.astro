---
import AppShell from '../../layouts/AppShell.astro'
import UploadDropzone from '../../islands/upload/UploadDropzone.tsx'
---

<AppShell title="Subir Excel" activePage="uploads">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="space-y-6">
      <div class="rounded-lg border surface-card p-6 md:p-8">
        <p class="text-xs uppercase tracking-widest text-brand">Carga controlada</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-main">
          Cargar reporte mensual de pagos QR
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-muted">
          El archivo se valida, se calcula su hash SHA-256 y se encola para
          procesamiento. Si ya fue subido antes, te llevamos a los resultados existentes.
        </p>
      </div>

      <UploadDropzone client:load />
    </div>

    <aside class="rounded-lg border surface-card-quiet p-5">
      <p class="text-xs uppercase tracking-widest text-faint">Flujo seguro</p>
      <ol class="mt-5 space-y-4 text-sm">
        <li class="flex gap-3">
          <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-md bg-brand text-xs font-semibold text-inverse">1</span>
          <span>
            <span class="block font-medium text-main">Prevalidacion local</span>
            <span class="text-muted">Se revisan hojas y columnas antes de enviar.</span>
          </span>
        </li>
        <li class="flex gap-3">
          <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-md bg-brand text-xs font-semibold text-inverse">2</span>
          <span>
            <span class="block font-medium text-main">Hash anti-duplicados</span>
            <span class="text-muted">El mismo Excel no genera resultados repetidos.</span>
          </span>
        </li>
        <li class="flex gap-3">
          <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-md bg-brand text-xs font-semibold text-inverse">3</span>
          <span>
            <span class="block font-medium text-main">Procesamiento aislado</span>
            <span class="text-muted">Procesamiento independiente del core Banexcoin.</span>
          </span>
        </li>
      </ol>
    </aside>
  </div>
</AppShell>
