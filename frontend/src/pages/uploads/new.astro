---
import AppShell from '../../layouts/AppShell.astro'
import UploadDropzone from '../../islands/upload/UploadDropzone.tsx'
---

<AppShell title="Subir Excel" activePage="uploads">
  <div class="grid min-w-0 gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div class="min-w-0 space-y-6">
      <section class="relative overflow-hidden rounded-xl border border-border bg-card/70 shadow-xl shadow-black/10">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -right-20 -top-20 h-60 w-60 rounded-full bg-primary/15 blur-3xl"
        />
        <div class="relative min-w-0 space-y-3 p-5 sm:p-6 md:p-8">
          <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
            Carga controlada
          </div>
          <h2 class="text-balance text-2xl font-semibold tracking-tight md:text-3xl">
            Cargar reporte mensual de pagos QR
          </h2>
          <p class="max-w-2xl text-pretty text-sm leading-6 text-muted-foreground">
            El archivo se valida, se calcula su hash SHA-256 y se encola para
            procesamiento. Si ya fue subido antes, te llevamos a los resultados existentes.
          </p>
        </div>
      </section>

      <UploadDropzone client:load />
    </div>

    <aside class="min-w-0 rounded-xl border border-border bg-card/50 p-5">
      <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">Flujo seguro</p>
      <ol class="mt-5 space-y-5 text-sm">
        <li class="flex gap-3">
          <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-md bg-primary text-primary-foreground text-xs font-semibold shadow shadow-primary/30">1</span>
          <span class="space-y-0.5">
            <span class="block font-medium text-foreground">Prevalidación local</span>
            <span class="block text-xs leading-5 text-muted-foreground">Se revisan hojas y columnas antes de enviar.</span>
          </span>
        </li>
        <li class="flex gap-3">
          <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-md bg-primary text-primary-foreground text-xs font-semibold shadow shadow-primary/30">2</span>
          <span class="space-y-0.5">
            <span class="block font-medium text-foreground">Hash anti-duplicados</span>
            <span class="block text-xs leading-5 text-muted-foreground">El mismo Excel no genera resultados repetidos.</span>
          </span>
        </li>
        <li class="flex gap-3">
          <span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-md bg-primary text-primary-foreground text-xs font-semibold shadow shadow-primary/30">3</span>
          <span class="space-y-0.5">
            <span class="block font-medium text-foreground">Procesamiento aislado</span>
            <span class="block text-xs leading-5 text-muted-foreground">Procesamiento independiente del core Banexcoin.</span>
          </span>
        </li>
      </ol>
    </aside>
  </div>
</AppShell>
