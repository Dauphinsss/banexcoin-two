---
import AppShell from '../../layouts/AppShell.astro'
import PageHeader from '../../components/PageHeader.astro'
import { DownloadsPanel } from '../../islands/reports/DownloadsPanel'
import { RebatesTable } from '../../islands/rebates/RebatesTable'
import { AnomalyPanel } from '../../islands/reconciliation/AnomalyPanel'

// Página estática: el id del upload llega como query param (?id=...).
// Lo resolvemos en el cliente para no requerir SSR (los islands ya
// cargan toda la data por API desde el navegador).
---

<AppShell title="Resultados del archivo" activePage="uploads">
  <div class="min-w-0 space-y-6">
    <PageHeader
      eyebrow="Archivo procesado"
      title="Resultados del archivo"
      accent="archivo"
      description="Vista del archivo procesado, con descargas, reintegros calculados y conciliación asociada a ese mismo archivo."
    />

    <div id="missing-id" hidden>
      <div
        class="rounded-xl border border-amber-500/40 bg-amber-500/10 px-5 py-4 text-sm text-amber-200"
        role="alert"
      >
        Falta el identificador del archivo en la URL. Vuelve a{' '}
        <a href="/uploads/new" class="font-medium underline underline-offset-4">
          subir un archivo
        </a>{' '}
        o ábrelo desde el dashboard.
      </div>
    </div>

    <div id="result-sections" class="space-y-6">
      <section class="space-y-4">
        <div class="flex items-center gap-3">
          <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
            Exportaciones
          </h3>
          <span class="h-px flex-1 bg-border"></span>
        </div>
        <DownloadsPanel client:visible />
      </section>

      <div class="pt-2">
        <div class="h-px w-full bg-linear-to-r from-transparent via-border to-transparent"></div>
      </div>

      <section class="space-y-4">
        <div class="flex items-center gap-3">
          <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
            Reintegros
          </h3>
          <span class="h-px flex-1 bg-border"></span>
        </div>
        <RebatesTable client:load />
      </section>

      <div class="pt-2">
        <div class="h-px w-full bg-linear-to-r from-transparent via-border to-transparent"></div>
      </div>

      <section class="space-y-4">
        <div class="flex items-center gap-3">
          <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
            Conciliación
          </h3>
          <span class="h-px flex-1 bg-border"></span>
        </div>
        <AnomalyPanel client:load />
      </section>
    </div>
  </div>
</AppShell>

<script>
  // Si no hay ?id= mostramos el aviso y ocultamos las secciones; los
  // islands leen el id directamente del query param en su propio código.
  const params = new URLSearchParams(window.location.search)
  if (!params.get('id')) {
    document.getElementById('missing-id')?.removeAttribute('hidden')
    document.getElementById('result-sections')?.setAttribute('hidden', '')
  }
</script>
