---
import AppShell from '../../layouts/AppShell.astro'
import PageHeader from '../../components/PageHeader.astro'
import { DownloadsPanel } from '../../islands/reports/DownloadsPanel'
import { RebatesTable } from '../../islands/rebates/RebatesTable'
import { AnomalyPanel } from '../../islands/reconciliation/AnomalyPanel'

export async function getStaticPaths() {
  return [{ params: { id: 'placeholder' } }]
}

const { id } = Astro.params
---

<AppShell title="Resultados del archivo" activePage="uploads">
  <div class="min-w-0 space-y-6">
    <PageHeader
      eyebrow="Archivo procesado"
      title="Resultados del archivo"
      accent="archivo"
      description="Vista del archivo procesado, con descargas, reintegros calculados y conciliación asociada a ese mismo archivo."
    />

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Exportaciones
        </h3>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <DownloadsPanel client:visible uploadId={id} />
    </section>

    <div class="pt-2">
      <div class="h-px w-full bg-linear-to-r from-transparent via-border to-transparent"></div>
    </div>

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Reintegros
        </h3>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <RebatesTable client:load uploadId={id} />
    </section>

    <div class="pt-2">
      <div class="h-px w-full bg-linear-to-r from-transparent via-border to-transparent"></div>
    </div>

    <section class="space-y-4">
      <div class="flex items-center gap-3">
        <h3 class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          Conciliación
        </h3>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      <AnomalyPanel client:load uploadId={id} />
    </section>
  </div>
</AppShell>
