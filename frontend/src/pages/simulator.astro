---
import AppShell from '../layouts/AppShell.astro'
import PageHeader from '../components/PageHeader.astro'
import { WhatIfSimulator } from '../islands/simulator/WhatIfSimulator'
---

<AppShell title="Simulador" activePage="simulator">
  <div class="min-w-0 space-y-6">
    <PageHeader
      eyebrow="Impacto "
      title="Simulador de cashback"
      accent="cashback"
      description="Ajusta porcentajes de reintegro y recalcula el costo en tiempo real usando las transacciones del último upload. Cuando una propuesta te convenza, expórtala como configuración para revisarla en Niveles."
    />

    <WhatIfSimulator client:load />
  </div>
</AppShell>
