---
import AppShell from '../layouts/AppShell.astro'
import { WhatIfSimulator } from '../islands/simulator/WhatIfSimulator'
---

<AppShell title="Simulador" activePage="simulator">
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-semibold tracking-tight text-slate-100">Simulador what-if</h2>
      <p class="mt-2 max-w-2xl text-sm text-slate-400">
        Ajusta porcentajes de reintegro y recalcula el costo usando las transacciones del último upload.
      </p>
    </div>

    <WhatIfSimulator client:load />
  </div>
</AppShell>
