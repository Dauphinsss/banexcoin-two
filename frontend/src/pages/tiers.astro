---
import AppShell from '../layouts/AppShell.astro'
import { TiersEditor } from '../islands/tiers/TiersEditor'
---

<AppShell title="Niveles" activePage="tiers">
  <div class="space-y-6">
    <section class="space-y-2">
      <div class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-medium text-primary">
        Reglas cashback
      </div>
      <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">Configuración de niveles</h2>
      <p class="max-w-2xl text-sm leading-6 text-muted-foreground">
        Tiers activos que el motor usa para calcular el cashback mensual.
        Edita rangos y porcentajes; el sistema valida solapamientos en tiempo real.
      </p>
    </section>

    <TiersEditor client:load />
  </div>
</AppShell>
