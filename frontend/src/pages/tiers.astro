---
import AppShell from '../layouts/AppShell.astro'
import PageHeader from '../components/PageHeader.astro'
import { TiersEditor } from '../islands/tiers/TiersEditor'
---

<AppShell title="Niveles" activePage="tiers">
  <div class="min-w-0 space-y-6">
    <PageHeader
      eyebrow="Reglas cashback"
      title="Configuración de niveles"
      accent="niveles"
      description="Tiers activos que el motor usa para calcular el cashback mensual. Edita rangos y porcentajes; el sistema valida solapamientos en tiempo real."
    />

    <TiersEditor client:load />
  </div>
</AppShell>
