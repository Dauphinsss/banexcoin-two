---
import '../styles/global.css'

interface Props {
  title: string
  activePage?: 'dashboard' | 'uploads' | 'rebates' | 'tiers' | 'reconciliation' | 'simulator'
}

const { title, activePage } = Astro.props
const navItems = [
  { id: 'dashboard',      href: '/',                 label: 'Dashboard' },
  { id: 'uploads',        href: '/uploads/new',      label: 'Subir Excel' },
  { id: 'rebates',        href: '/rebates',          label: 'Reintegros' },
  { id: 'reconciliation', href: '/reconciliation',   label: 'Conciliación' },
  { id: 'tiers',          href: '/tiers',            label: 'Niveles' },
  { id: 'simulator',      href: '/simulator',        label: 'Simulador' },
] as const
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · BanexReintegra</title>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <div class="flex min-h-screen">
      <aside class="hidden md:flex md:w-64 flex-col border-r border-slate-800 bg-slate-950/60">
        <div class="px-6 py-6 border-b border-slate-800">
          <p class="text-sm uppercase tracking-widest text-slate-500">Banexcoin</p>
          <p class="text-lg font-semibold text-slate-100">BanexReintegra</p>
        </div>
        <nav class="flex-1 px-3 py-4 space-y-1">
          {navItems.map((item) => (
            <a
              href={item.href}
              class={`block px-3 py-2 rounded-md text-sm transition-colors ${
                item.id === activePage
                  ? 'bg-blue-600/20 text-blue-200 font-medium'
                  : 'text-slate-400 hover:text-slate-100 hover:bg-slate-800/60'
              }`}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </aside>

      <main class="flex-1 flex flex-col">
        <header class="border-b border-slate-800 px-6 py-4 flex items-center justify-between">
          <h1 class="text-lg font-semibold tracking-tight">{title}</h1>
          <div class="text-xs text-slate-500 font-mono">api: localhost:3000</div>
        </header>
        <section class="flex-1 px-6 py-8">
          <slot />
        </section>
      </main>
    </div>
  </body>
</html>
