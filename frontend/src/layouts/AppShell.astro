---
import '../styles/global.css'

interface Props {
  title: string
  activePage?: 'dashboard' | 'uploads' | 'rebates' | 'tiers' | 'reconciliation' | 'simulator'
}

const { title, activePage } = Astro.props

type NavId = NonNullable<Props['activePage']>
const navItems: Array<{ id: NavId; href: string; label: string; hint: string; icon: string }> = [
  {
    id: 'dashboard',
    href: '/',
    label: 'Dashboard',
    hint: 'Resumen mensual',
    icon: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  },
  {
    id: 'uploads',
    href: '/uploads/new',
    label: 'Subir Excel',
    hint: 'Validar archivo',
    icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>',
  },
  {
    id: 'rebates',
    href: '/rebates',
    label: 'Reintegros',
    hint: 'Usuarios y pagos',
    icon: '<circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/>',
  },
  {
    id: 'reconciliation',
    href: '/reconciliation',
    label: 'Conciliación',
    hint: 'Control bancario',
    icon: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/><path d="m16 16-1.9-1.9"/>',
  },
  {
    id: 'tiers',
    href: '/tiers',
    label: 'Niveles',
    hint: 'Reglas cashback',
    icon: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  },
  {
    id: 'simulator',
    href: '/simulator',
    label: 'Simulador',
    hint: 'Impacto what-if',
    icon: '<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>',
  },
]

const currentItem = navItems.find((item) => item.id === activePage)
---

<html lang="es" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · BanexReintegra</title>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased font-sans">
    <div class="relative flex min-h-screen">
      {/* Decorative gradient glow */}
      <div
        aria-hidden="true"
        class="pointer-events-none fixed inset-x-0 top-0 -z-10 h-[420px] bg-[radial-gradient(60%_60%_at_50%_0%,oklch(0.665_0.205_35/0.12)_0%,transparent_70%)]"
      />

      {/* Sidebar */}
      <aside class="hidden md:flex md:w-72 flex-col border-r border-sidebar-border bg-sidebar">
        <div class="flex h-16 items-center gap-3 border-b border-sidebar-border px-6">
          <a href="/" class="flex items-center gap-3" aria-label="Inicio BanexReintegra">
            <div class="grid size-10 place-items-center rounded-lg bg-primary text-primary-foreground text-sm font-bold shadow-lg shadow-primary/30 ring-1 ring-primary/40">
              BR
            </div>
            <div class="leading-tight">
              <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">Banexcoin</p>
              <p class="text-[15px] font-semibold tracking-tight">BanexReintegra</p>
            </div>
          </a>
        </div>

        <nav class="flex-1 space-y-1 p-3" aria-label="Navegación principal">
          {navItems.map((item) => {
            const isActive = item.id === activePage
            return (
              <a
                href={item.href}
                aria-label={item.label}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'group flex items-center gap-3 rounded-md px-3 py-2.5 text-sm transition-colors',
                  isActive
                    ? 'bg-sidebar-accent text-sidebar-accent-foreground'
                    : 'text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-foreground',
                ]}
              >
                <span
                  class:list={[
                    'flex size-8 shrink-0 items-center justify-center rounded-md transition-colors',
                    isActive
                      ? 'bg-primary/15 text-primary ring-1 ring-primary/30'
                      : 'bg-sidebar-accent/60 text-muted-foreground group-hover:text-sidebar-foreground',
                  ]}
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={item.icon}
                  />
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block font-medium">{item.label}</span>
                  <span class="block text-[11px] text-muted-foreground">{item.hint}</span>
                </span>
                {isActive ? <span class="size-1.5 rounded-full bg-primary shadow-[0_0_0_4px_oklch(0.665_0.205_35/0.18)]" /> : null}
              </a>
            )
          })}
        </nav>

        <div class="mx-3 mb-3 rounded-lg border border-sidebar-border bg-sidebar-accent/40 p-4">
          <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">Estado API</p>
          <div class="mt-2.5 flex items-center gap-2.5 text-sm">
            <span class="relative flex size-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-50" />
              <span class="relative inline-flex size-2 rounded-full bg-emerald-500" />
            </span>
            <span class="font-mono text-xs text-sidebar-foreground">localhost:3000</span>
          </div>
        </div>
      </aside>

      {/* Main */}
      <main class="flex-1 min-w-0 flex flex-col">
        <header class="sticky top-0 z-20 flex h-16 items-center gap-4 border-b border-border bg-background/80 px-4 backdrop-blur-xl md:px-8">
          <div class="flex-1 min-w-0">
            <p class="text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">{currentItem?.hint ?? 'Operación'}</p>
            <h1 class="truncate text-lg font-semibold tracking-tight md:text-xl">{title}</h1>
          </div>
          <a
            href="/uploads/new"
            class="hidden md:inline-flex items-center gap-2 rounded-md bg-primary px-4 h-9 text-sm font-medium text-primary-foreground shadow-sm transition-all hover:bg-primary/90 hover:shadow-md hover:shadow-primary/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="M12 5v14" />
            </svg>
            Nuevo upload
          </a>
        </header>

        {/* Mobile nav */}
        <nav class="md:hidden flex gap-2 overflow-x-auto border-b border-border bg-background/60 px-4 py-3 backdrop-blur-xl" aria-label="Navegación móvil">
          {navItems.map((item) => {
            const isActive = item.id === activePage
            return (
              <a
                href={item.href}
                aria-label={item.label}
                class:list={[
                  'shrink-0 rounded-md border px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'border-primary/40 bg-primary/15 text-foreground'
                    : 'border-border bg-card/40 text-muted-foreground hover:text-foreground',
                ]}
              >
                {item.label}
              </a>
            )
          })}
        </nav>

        <section class="flex-1 px-4 py-6 md:px-8 md:py-8">
          <div class="mx-auto w-full max-w-7xl">
            <slot />
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
