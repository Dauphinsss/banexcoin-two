---
import '../styles/global.css'
import { OnboardingTour } from '../islands/shared/OnboardingTour'

interface Props {
  title: string
  activePage?: 'dashboard' | 'uploads' | 'rebates' | 'tiers' | 'reconciliation' | 'simulator'
}

const { title, activePage } = Astro.props

type NavId = NonNullable<Props['activePage']>
const navItems: Array<{
  id: NavId
  href: string
  label: string
  hint: string
  description: string
  bullets: string[]
  icon: string
}> = [
  {
    id: 'dashboard',
    href: '/',
    label: 'Dashboard',
    hint: 'Resumen mensual',
    description: 'Vista ejecutiva del cierre más reciente con montos, usuarios, conciliación y alertas operativas.',
    bullets: ['Resumen del período', 'Acceso rápido a resultados', 'Indicadores del cierre'],
    icon: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
  },
  {
    id: 'uploads',
    href: '/uploads/new',
    label: 'Subir Excel',
    hint: 'Validar archivo',
    description: 'Carga el reporte mensual, revisa la vista previa y procesa el archivo sin duplicar resultados.',
    bullets: ['Vista previa antes de procesar', 'Control de duplicados', 'Entrada del flujo mensual'],
    icon: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>',
  },
  {
    id: 'rebates',
    href: '/rebates',
    label: 'Reintegros',
    hint: 'Usuarios y pagos',
    description: 'Tabla por usuario con el cashback calculado, filtros operativos y acceso al detalle individual.',
    bullets: ['Montos por usuario', 'Filtros y búsqueda', 'Exportación de resultados'],
    icon: '<circle cx="8" cy="8" r="6"/><path d="M18.09 10.37A6 6 0 1 1 10.34 18"/><path d="M7 6h1v4"/><path d="m16.71 13.88.7.71-2.82 2.82"/>',
  },
  {
    id: 'reconciliation',
    href: '/reconciliation',
    label: 'Conciliación',
    hint: 'Control bancario',
    description: 'Revisa diferencias entre pagos QR y extractos, resuelve incidencias y usa apoyo de IA cuando haga falta.',
    bullets: ['Anomalías por tipo', 'Resolución manual', 'Apoyo para análisis'],
    icon: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/><path d="m16 16-1.9-1.9"/>',
  },
  {
    id: 'tiers',
    href: '/tiers',
    label: 'Niveles',
    hint: 'Reglas cashback',
    description: 'Administra los niveles vigentes y publica configuraciones por período con validación de tramos.',
    bullets: ['Edición de niveles', 'Historial por período', 'Publicación controlada'],
    icon: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
  },
  {
    id: 'simulator',
    href: '/simulator',
    label: 'Simulador',
    hint: 'Impacto',
    description: 'Prueba cambios de política antes de publicarlos y compara el costo estimado contra la configuración base.',
    bullets: ['Escenario base vs simulado', 'Impacto en costo total', 'Puente hacia niveles'],
    icon: '<rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/>',
  },
]

const currentItem = navItems.find((item) => item.id === activePage)
---

<html lang="es" class="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171724" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Manrope:wght@400;500;600;700;800&display=swap"
    />
    <title>{title} · BanexReintegra</title>
    <!-- SEO Meta Tags -->
    <meta name="description" content="BanexReintegra es una plataforma de cálculo de cashback mensual, conciliación bancaria y generación de reportes para Banexcoin. Permite cargar Excel, simular políticas y descargar BanexTransfer, todo sin servidores." />
    <meta name="keywords" content="BanexReintegra, Banexcoin, cashback, QR payments, Bolivia, fintech, conciliación bancaria, Excel, reporte financiero, reintegros, simulador what‑if, conciliación" />
    <link rel="canonical" href={"https://banexcoin.com" + (Astro.url?.pathname ?? "")} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title + " · BanexReintegra"} />
    <meta property="og:description" content="BanexReintegra es una plataforma de cálculo de cashback mensual, conciliación bancaria y generación de reportes para Banexcoin. Permite cargar Excel, simular políticas y descargar BanexTransfer, todo sin servidores." />
    <meta property="og:url" content={"https://banexcoin.com" + (Astro.url?.pathname ?? "")} />
    <meta property="og:image" content="https://example.com/og-image.png" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="BanexReintegra" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title + " · BanexReintegra"} />
    <meta name="twitter:description" content="BanexReintegra es una plataforma de cálculo de cashback mensual, conciliación bancaria y generación de reportes para Banexcoin." />
    <meta name="twitter:image" content="https://example.com/og-image.png" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased font-sans">
    <a
      href="#main-content"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:left-4 focus-visible:top-4 focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-primary focus-visible:px-4 focus-visible:py-2 focus-visible:text-sm focus-visible:font-medium focus-visible:text-primary-foreground focus-visible:ring-2 focus-visible:ring-primary/40"
    >
      Saltar al contenido
    </a>
    <div class="page-shell relative flex h-screen overflow-hidden">
      {/* Decorative gradient glow */}
      <div
        aria-hidden="true"
        class="ambient-glow pointer-events-none fixed inset-x-0 top-0 -z-10 h-[420px] bg-[radial-gradient(60%_60%_at_50%_0%,oklch(0.665_0.205_35/0.12)_0%,transparent_70%)]"
      />

      {/* Sidebar */}
      <aside class="app-sidebar hidden md:flex md:w-72 flex-col border-r border-sidebar-border bg-sidebar">
        <div class="flex h-[72px] items-center border-b border-sidebar-border px-6">
          <a href="/" class="block" aria-label="Inicio BanexReintegra">
            <img
              src="/logo.png"
              alt="Banexcoin · BanexReintegra"
              width="188"
              height="28"
              class="h-7 max-w-[190px] w-auto object-contain"
            />
          </a>
        </div>

        <nav class="flex-1 space-y-1 overflow-y-auto p-3" aria-label="Navegación principal">
          {navItems.map((item) => {
            const isActive = item.id === activePage
            return (
              <div class="nav-item group relative">
                <a
                  href={item.href}
                  id={`nav-${item.id}`}
                  aria-label={item.label}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'nav-link relative flex items-center gap-3 rounded-md px-3 py-2.5 text-sm transition-colors',
                    isActive
                      ? 'bg-sidebar-accent text-sidebar-accent-foreground'
                      : 'text-muted-foreground hover:bg-sidebar-accent/60 hover:text-sidebar-foreground',
                  ]}
                >
                  {isActive ? (
                    <span
                      aria-hidden="true"
                      class="absolute left-0 top-1/2 h-7 w-1 -translate-y-1/2 rounded-r-full bg-primary"
                    />
                  ) : null}
                  <span
                    class:list={[
                      'nav-icon flex size-8 shrink-0 items-center justify-center rounded-md transition-colors',
                      isActive
                        ? 'bg-primary/15 text-primary ring-1 ring-primary/30'
                        : 'bg-sidebar-accent/60 text-muted-foreground group-hover:text-sidebar-foreground',
                    ]}
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={item.icon}
                    />
                  </span>
                  <span class="flex-1 min-w-0">
                    <span class="block font-medium">{item.label}</span>
                    <span class="block text-[11px] text-muted-foreground">{item.hint}</span>
                  </span>
                </a>

                <div class="nav-hover-card pointer-events-none absolute left-[calc(100%+0.85rem)] top-1/2 z-30 hidden w-72 -translate-y-1/2 rounded-xl border border-border/80 bg-card/96 p-4 text-left opacity-0 shadow-2xl shadow-black/35 backdrop-blur-xl transition-[opacity,transform] duration-180 md:block">
                  <div class="space-y-3">
                    <div class="space-y-1.5">
                      <p class="text-sm font-semibold text-foreground">{item.label}</p>
                      <p class="text-xs leading-relaxed text-muted-foreground">{item.description}</p>
                    </div>
                    <div class="space-y-2">
                      {item.bullets.map((bullet) => (
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                          <span class="size-1.5 shrink-0 rounded-full bg-primary"></span>
                          <span>{bullet}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            )
          })}
        </nav>

      </aside>

      {/* Main */}
      <main id="main-content" class="flex-1 min-w-0 flex flex-col overflow-y-auto overscroll-contain">
        <header class="app-header sticky top-0 z-40 flex h-[72px] shrink-0 items-center gap-4 border-b border-border bg-background/90 px-4 backdrop-blur-xl md:px-8">
          <div class="flex-1 min-w-0">
            <p class="leading-4 text-[10px] font-medium uppercase tracking-[0.18em] text-muted-foreground">{currentItem?.hint ?? 'Operación'}</p>
            <h1 class="truncate text-lg font-semibold leading-7 tracking-tight md:text-xl">{title}</h1>
          </div>
         
        </header>

        {/* Mobile nav */}
        <nav class="mobile-nav md:hidden flex gap-2 overflow-x-auto overscroll-x-contain border-b border-border bg-background/60 px-4 py-3 backdrop-blur-xl" aria-label="Navegación móvil">
          {navItems.map((item) => {
            const isActive = item.id === activePage
            return (
              <a
                href={item.href}
                aria-label={item.label}
                class:list={[
                  'mobile-nav-link shrink-0 rounded-md border px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'border-primary/40 bg-primary/15 text-foreground'
                    : 'border-border bg-card/40 text-muted-foreground hover:text-foreground',
                ]}
              >
                {item.label}
              </a>
            )
          })}
        </nav>

        <section class="page-content flex-1 px-4 py-6 md:px-8 md:py-8">
          <div class="page-frame w-full min-w-0">
            <slot />
          </div>
        </section>
      </main>
    </div>

    <OnboardingTour client:only="react" />
  </body>
</html>
